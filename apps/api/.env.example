# =============================================================================
# BrooStore API — variáveis de ambiente (NENHUM valor real aqui).
# Local: copie para ".env" (não vai para o Git). Render: Dashboard > Environment.
# Linhas comentadas (#) são opcionais: o valor mostrado é o PADRÃO do código.
# =============================================================================

# --- Banco de dados ----------------------------------------------------------
# Render: "Internal Database URL" do Postgres. Padrão (dev): SQLite local.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO
# DATABASE_URL=sqlite:///cobrancas.db

# --- Segurança ---------------------------------------------------------------
# Defina em produção! Se faltar, a API usa um valor padrão embutido e registra um aviso no log.
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio

# --- Fila (Redis + RQ) -------------------------------------------------------
# Web e worker apontam para o MESMO Redis. O worker exige esta variável.
REDIS_URL=redis://HOST:6379

# --- Mercado Pago ------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# Segredo do webhook (painel do Mercado Pago > Webhooks), usado só se a validação estiver ligada.
WEBHOOK_SECRET=
# "true" ou "1" liga a validação da assinatura x-signature do webhook. PADRÃO: desligada
# (comportamento original). Ligue só depois de testar com um pagamento real de valor baixo.
# WEBHOOK_VALIDATE_SIGNATURE=false

# --- Supabase (REST) ---------------------------------------------------------
# SUPABASE_URL=https://gyepvrzkwesohbagpgfa.supabase.co
# SUPABASE_ANON_KEY=<chave pública (anon); o código já tem a do projeto atual como padrão>
# Chave de serviço: SÓ no worker (registra vendas na tabela "sales" do Supabase).
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail de entrega (SMTP) ------------------------------------------------
EMAIL_USER=
EMAIL_PASSWORD=
# SMTP_SERVER=smtp.zoho.com
# SMTP_PORT=587

# --- E-mail do formulário de contato (Resend) --------------------------------
RESEND_API_KEY=

# --- Frete (Melhor Envio) ----------------------------------------------------
MELHOR_ENVIO_TOKEN=
CEP_ORIGEM=00000000
# MELHOR_ENVIO_URL=https://www.melhorenvio.com.br/api/v2
# MELHOR_ENVIO_EMAIL=entrega.broo@zohomail.com

# --- Painel financeiro (/api/admin/dashboard) --------------------------------
# Sem ADMIN_TOKEN o endpoint responde sempre 401. O painel envia o valor no header X-Admin-Token.
ADMIN_TOKEN=
# Opcional: origem (CORS) do painel quando ele roda em outro domínio. Padrão: não liberado.
# DASHBOARD_ORIGIN=https://painel.exemplo.com
# Dominios extras do frontend liberados no CORS (separados por virgula)
# CORS_EXTRA_ORIGINS=https://www.broostore.com.br,https://loja.exemplo.com

# --- Cron de avisos de expiração ---------------------------------------------
# BROOSTOCK_URL=https://brootechstock.netlify.app/login

# --- Servidor local (python -m flask / execução direta) ----------------------
# PORT=5000
